struct HeaderField {
    name: String
    value: String
    never_index: bool (false)

    fn entry_size() uint {
        return this.name.bytes + this.value.bytes + 32
    }
}

fn hpack_read_int(data: local &[u8], pos: uint, prefix: uint) (uint, uint) !GrpcError {
    if prefix == 0 || prefix > 8 || pos >= data.length {
        throw err(.internal, "HPACK integer truncated")
    }
    let mask: uint = (1 << prefix) - 1
    let result = data[pos].to(uint) & mask
    pos++
    if result < mask : return (result, pos)
    let shift: uint = 0
    while pos < data.length {
        let b = data[pos].to(uint)
        pos++
        let part = b & 127
        if shift > 56 : throw err(.internal, "HPACK integer overflow")
        result = result.checked_add(part << shift) ! throw err(.internal, "HPACK integer overflow")
        if (b & 128) == 0 : return (result, pos)
        shift += 7
    }
    throw err(.internal, "HPACK integer truncated")
}

fn hpack_write_int(out: ByteBuffer, number: uint, prefix: uint, flags: u8) {
    let mask: uint = (1 << prefix) - 1
    if number < mask {
        out.write_byte(flags | number.to(u8))
        return
    }
    out.write_byte(flags | mask.to(u8))
    number -= mask
    while number >= 128 {
        out.write_byte((number & 127).to(u8) | 128)
        number = number >> 7
    }
    out.write_byte(number.to(u8))
}

fn hpack_decode_huffman(data: local &[u8], limit: uint) String !GrpcError {
    if data.length == 0 : return ""
    let out = ByteBuffer.new(data.length * 2)
    let node: uint = 0
    let i: uint = 0
    while i < data.length {
        let b = data[i].to(uint)
        let bit: uint = 8
        while bit > 0 {
            bit--
            let one = ((b >> bit) & 1) != 0
            let next = one ? hpack_huff_right[node] : hpack_huff_left[node]
            if next < 0 : throw err(.internal, "Invalid HPACK Huffman code")
            node = next.to(uint)
            let sym = hpack_huff_symbol[node]
            if sym >= 0 {
                if sym == 256 : throw err(.internal, "HPACK Huffman EOS symbol")
                if out.length >= limit : throw err(.resource_exhausted, "HPACK header string too large")
                out.write_byte(sym.to(u8))
                node = 0
            }
        }
        i++
    }
    // Any remaining bits must be valid 1-padding (nodes 0..7 are all-1s prefix of EOS)
    if node > 7 : throw err(.internal, "Invalid HPACK Huffman padding")
    return out.into_string()
}

fn hpack_read_str(data: local &[u8], pos: uint, limit: uint) (String, uint) !GrpcError {
    if pos >= data.length : throw err(.internal, "HPACK string truncated")
    let huffman = (data[pos] & 128) != 0
    let len, next_pos = hpack_read_int(data, pos, 7) !>
    if len > data.length - next_pos : throw err(.internal, "HPACK string length out of bounds")
    if !huffman && len > limit : throw err(.resource_exhausted, "HPACK header string too large")
    let slice = data.view(next_pos, len)
    let end_pos = next_pos + len
    if huffman {
        return (hpack_decode_huffman(slice, limit) !>, end_pos)
    }
    return (slice.to_string(), end_pos)
}

fn hpack_static_lookup(name: String, value: String) (uint, uint) {
    let name_idx: uint = 0
    let i: uint = 0
    while i < 61 {
        if hpack_static_names[i] == name {
            if name_idx == 0 : name_idx = i + 1
            if hpack_static_values[i] == value : return (name_idx, i + 1)
        }
        i++
    }
    return (name_idx, 0)
}

class HpackDecoder {
    entries: Array[HeaderField] (.{})
    size: uint (0)
    capacity: uint (4096)
    allowed_capacity: uint (4096)
    max_header_size: uint (65_536)

    fn set_max_table_size(limit: uint) {
        this.allowed_capacity = limit
        if limit < this.capacity {
            this.capacity = limit
            this.evict(limit)
        }
    }

    fn evict(limit: uint) {
        while this.size > limit && this.entries.length > 0 {
            let last = this.entries.get(this.entries.length - 1) ! break
            this.size -= last.entry_size()
            this.entries.remove(this.entries.length - 1)
        }
    }

    fn insert(field: HeaderField) {
        let esz = field.entry_size()
        if esz > this.capacity {
            this.evict(0)
            return
        }
        this.evict(this.capacity - esz)
        this.entries.prepend(field)
        this.size += esz
    }

    fn lookup(index: uint) HeaderField !GrpcError {
        if index == 0 : throw err(.internal, "HPACK index 0")
        if index <= 61 {
            return HeaderField {
                name: hpack_static_names[index - 1]
                value: hpack_static_values[index - 1]
            }
        }
        let dyn_idx = index - 62
        return this.entries.get(dyn_idx) ! throw err(.internal, "HPACK index out of range")
    }

    fn decode(block: local &[u8]) Array[HeaderField] !GrpcError {
        let fields = Array[HeaderField].new(8)
        let pos: uint = 0
        let total_size: uint = 0
        let fields_started = false
        while pos < block.length {
            let first = block[pos]
            if (first & 0xE0) == 0x20 {
                // Dynamic table size update
                if fields_started : throw err(.internal, "HPACK table size update after header")
                let new_cap, next_pos = hpack_read_int(block, pos, 5) !>
                pos = next_pos
                if new_cap > this.allowed_capacity : throw err(.internal, "HPACK table size exceeds limit")
                this.capacity = new_cap
                this.evict(new_cap)
                continue
            }
            fields_started = true
            let field = HeaderField { name: "", value: "" }
            if (first & 0x80) != 0 {
                // Indexed header field
                let idx, next_pos = hpack_read_int(block, pos, 7) !>
                pos = next_pos
                field = this.lookup(idx) !>
            } else {
                let incremental = (first & 0x40) != 0
                let prefix: uint = incremental ? 6 : 4
                let idx, next_pos = hpack_read_int(block, pos, prefix) !>
                pos = next_pos
                let name = ""
                if idx != 0 {
                    let entry = this.lookup(idx) !>
                    name = entry.name
                } else {
                    let n, np = hpack_read_str(block, pos, this.max_header_size) !>
                    name = n
                    pos = np
                }
                let val, vp = hpack_read_str(block, pos, this.max_header_size) !>
                pos = vp
                field = HeaderField { name: name, value: val }
                if incremental : this.insert(field)
            }
            let esz = field.entry_size()
            if total_size > this.max_header_size || esz > this.max_header_size - total_size {
                throw err(.resource_exhausted, "HPACK header list exceeds limit")
            }
            total_size += esz
            fields.append(field)
        }
        return fields
    }
}

class HpackEncoder {
    fn encode(fields: Array[HeaderField]) String {
        let out = ByteBuffer.new(128)
        each fields as field {
            let name_idx, exact_idx = hpack_static_lookup(field.name, field.value)
            if exact_idx != 0 && !field.never_index {
                hpack_write_int(out, exact_idx, 7, 0x80)
                continue
            }
            let prefix_flag: u8 = field.never_index ? 0x10 : 0x00
            hpack_write_int(out, name_idx, 4, prefix_flag)
            if name_idx == 0 {
                hpack_write_int(out, field.name.bytes, 7, 0)
                out.write(field.name)
            }
            hpack_write_int(out, field.value.bytes, 7, 0)
            out.write(field.value)
        }
        return out.into_string()
    }
}
