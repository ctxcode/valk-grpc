use valk.net
use valk.sync
use valk.time
use valk.crypto

/// Connection and default RPC settings for `GrpcClient`.
+ class ClientOptions {
    /// Use TLS with HTTP/2 ALPN (`h2`). Automatically enabled for `https://` targets.
    + tls: bool (false)
    /// Verify the server TLS certificate (disable only for self-signed test servers).
    + verify_tls: bool (true)
    /// Optional CA certificate PEM file for verifying the server certificate.
    + ca_cert_path: ?String (null)
    /// Optional client certificate PEM file for mutual TLS.
    + client_cert_file: ?String (null)
    /// Optional client private key PEM file for mutual TLS.
    + client_key_file: ?String (null)
    /// Custom `:authority` header override (defaults to `host:port`).
    + authority: ?String (null)
    /// TCP connect + TLS handshake timeout in milliseconds.
    + connect_timeout_ms: uint (5_000)
    /// Default per-RPC timeout in milliseconds (0 disables default timeout).
    + default_timeout_ms: uint (0)
    /// Socket write timeout in milliseconds.
    + write_timeout_ms: uint (5_000)
    /// Maximum incoming message size in bytes.
    + max_recv_message_size: uint (DEFAULT_MAX_MESSAGE_SIZE)
    /// Maximum outgoing message size in bytes.
    + max_send_message_size: uint (DEFAULT_MAX_MESSAGE_SIZE)
    /// Default request compression algorithm.
    + compression: Compression (.identity)
    /// `user-agent` header value sent on RPCs.
    + user_agent: String ("valk-grpc/0.1")
}

/// Client-side handle for an open gRPC stream (server-streaming, client-streaming, or bidi).
+ class ClientStream {
    - client: GrpcClient
    - stream_id: u32
    - waker: sync.Waker
    - decoder: FrameDecoder
    - compression: Compression (.identity)
    - max_send_size: uint (DEFAULT_MAX_MESSAGE_SIZE)
    - deadline_ms: uint (0)
    - send_window: int (H2_DEFAULT_WINDOW)
    - recv_window: int (H2_TARGET_WINDOW)
    - unacked_recv: uint (0)
    - send_closed: bool (false)
    - headers_received: bool (false)
    - trailers_received: bool (false)
    - remote_eof: bool (false)
    - http_status: u16 (0)
    - grpc_status_set: bool (false)
    - grpc_status_code: i32 (0)
    - grpc_message: String ("")
    - grpc_details_bin: String ("")
    - resp_headers: Metadata (.{})
    - resp_trailers: Metadata (.{})
    - transport_error: ?GrpcError (null)
    - send_window_waiters: Array[sync.Waker] (.{})

    /// Sends one length-prefixed request message on the stream.
    + fn send(payload: local &[u8]) !GrpcError {
        if this.send_closed : throw err(.failed_precondition, "Cannot send after close_send()")
        this.check_deadline() !>
        let terr = this.transport_error
        if isset(terr) : throw terr
        let frame = encode_frame(payload, this.compression, this.max_send_size) !>
        this.client.send_stream_data(this, frame, false) !>
    }

    /// Half-closes the client send direction (`END_STREAM`).
    + fn close_send() !GrpcError {
        if this.send_closed : return
        this.send_closed = true
        this.client.send_stream_data(this, "", true) !>
    }

    /// Waits for initial response metadata headers from the server and returns them.
    + fn headers() Metadata !GrpcError {
        while !this.headers_received && !this.remote_eof {
            this.check_deadline() !>
            let terr = this.transport_error
            if isset(terr) : throw terr
            if this.client.closed : throw err(.unavailable, "Connection closed")
            this.wait_step() !>
        }
        let terr = this.transport_error
        if isset(terr) && !this.headers_received : throw terr
        return this.resp_headers
    }

    /// Receives the next response message from the server, or `null` on clean OK EOF.
    /// Throws `GrpcError` when the server returns a non-OK gRPC status, deadline expires,
    /// or transport/framing fails.
    + fn recv() ?String !GrpcError {
        while true {
            let msg = this.decoder.next() ! {
                this.cancel()
                throw E
            }
            if isset(msg) : return msg

            if this.remote_eof {
                let terr = this.transport_error
                if isset(terr) : throw terr
                if this.decoder.has_partial() {
                    throw err(.internal, "Truncated gRPC response message")
                }
                this.verify_final_status() !>
                return null
            }

            this.check_deadline() !>
            if this.client.closed {
                let terr = this.transport_error
                if isset(terr) : throw terr
                throw err(.unavailable, "Connection closed")
            }
            this.wait_step() !>
        }
    }

    /// Convenience for client-streaming RPCs: closes send side, reads the single response message,
    /// verifies trailers, and returns `(body, trailers)`.
    + fn finish() (String, Metadata) !GrpcError {
        this.close_send() !>
        let body = (this.recv() !>) ?? ""
        // Drain to verify trailing status if not yet at EOF
        if !this.remote_eof {
            let extra = this.recv() !>
            if isset(extra) {
                this.cancel()
                throw err(.internal, "Expected single response message for client-streaming RPC")
            }
        }
        return (body, this.resp_trailers)
    }

    /// Returns response trailers (populated once the server closes the stream).
    + fn trailers() Metadata {
        return this.resp_trailers
    }

    /// Cancels the active RPC stream by sending HTTP/2 `RST_STREAM(CANCEL)`.
    + fn cancel() {
        if this.remote_eof : return
        this.remote_eof = true
        this.transport_error = err(.cancelled, "RPC cancelled by client")
        this.client.cancel_stream(this.stream_id)
        this.wake_window_waiters()
        this.waker.wake()
    }

    fn check_deadline() !GrpcError {
        if this.deadline_ms == 0 : return
        if time.mono_ms() >= this.deadline_ms {
            if !this.remote_eof {
                this.remote_eof = true
                this.client.cancel_stream(this.stream_id)
            }
            throw err(.deadline_exceeded, "RPC deadline exceeded")
        }
    }

    fn wait_step() !GrpcError {
        let wait_ms: uint = 50
        if this.deadline_ms > 0 {
            let now = time.mono_ms()
            if now >= this.deadline_ms {
                this.check_deadline() !>
            }
            let rem = this.deadline_ms - now
            if rem < wait_ms : wait_ms = rem
        }
        this.waker.wait(wait_ms)
    }

    fn verify_final_status() !GrpcError {
        if this.grpc_status_set {
            let code = status_code_from_int(this.grpc_status_code)
            if code == .ok : return
            let det = ""
            if this.grpc_details_bin.bytes > 0 {
                det = crypto.base64_decode(this.grpc_details_bin) !? ""
            }
            throw err(code, percent_decode(this.grpc_message), det)
        }
        if this.http_status != 200 && this.http_status != 0 {
            throw err(status_code_from_http(this.http_status), "HTTP status %{this.http_status}")
        }
        throw err(.unknown, "Server closed stream without grpc-status trailer")
    }

    fn fail(e: GrpcError) {
        if !isset(this.transport_error) : this.transport_error = e
        this.remote_eof = true
        this.wake_window_waiters()
        this.waker.wake()
    }

    fn wake_window_waiters() {
        while this.send_window_waiters.length > 0 {
            let w = this.send_window_waiters.pop_first() ! break
            w.wake()
        }
    }
}

/// Multiplexed gRPC HTTP/2 client supporting cleartext `h2c` and TLS ALPN `h2`.
+ class GrpcClient {
    - con: net.TcpConnection
    - scheme: String ("http")
    - authority: String ("")
    - opts: ClientOptions (.{})
    - closed: bool (false)
    - goaway: bool (false)
    - next_stream_id: u32 (1)
    - peer_settings: H2Settings (.{})
    - decoder: HpackDecoder (.{})
    - encoder: HpackEncoder (.{})
    - assembler: H2HeaderAssembler (.{})
    - streams: HashMap[u32, ClientStream] (.new())
    - recv_buf: ByteBuffer (.new(16_384))
    - send_window: int (H2_DEFAULT_WINDOW)
    - conn_recv_window: int (H2_TARGET_WINDOW)
    - conn_unacked_recv: uint (0)
    - write_busy: bool (false)
    - write_waiters: Array[sync.Waker] (.{})
    - window_waiters: Array[sync.Waker] (.{})

    /// Connects to a gRPC server at `target` (e.g. `"127.0.0.1:50051"`, `"http://host:port"`, or `"https://host:port"`).
    + static fn connect(target: String, options: ?ClientOptions (null)) SELF !GrpcError {
        let opts = options ?? ClientOptions {}
        let host, port, use_tls = parse_grpc_target(target, opts.tls) !>
        let authority = opts.authority ?? "%{host}:%{port}"
        let scheme = use_tls ? "https" : "http"

        let con = net.TcpConnection.new(host, port, opts.connect_timeout_ms) ! {
            throw err(.unavailable, "Failed to connect to gRPC server %{host}:%{port}")
        }

        if use_tls {
            let ssl = net.Ssl.new()
            ssl.set_verify(opts.verify_tls)
            let ca = opts.ca_cert_path
            if isset(ca) {
                ssl.set_ca_cert(ca) ! {
                    con.close() ! {}
                    throw err(.internal, "Failed to load CA certificate")
                }
            }
            let ccert = opts.client_cert_file
            let ckey = opts.client_key_file
            if isset(ccert) && isset(ckey) {
                ssl.set_certificate(ccert, ckey) ! {
                    con.close() ! {}
                    throw err(.internal, "Failed to load client certificate")
                }
            }
            ssl.set_alpn(Array[String]{ "h2" }) ! {
                con.close() ! {}
                throw err(.internal, "Failed to configure h2 ALPN")
            }
            con.ssl_connect(ssl, opts.connect_timeout_ms) ! {
                con.close() ! {}
                throw err(.unavailable, "TLS handshake failed for %{host}:%{port}")
            }
            if ssl.selected_alpn() != "h2" {
                con.close() ! {}
                throw err(.unavailable, "Server did not negotiate ALPN h2")
            }
        }

        let client = SELF {
            con: con
            scheme: scheme
            authority: authority
            opts: opts
        }
        client.send_preface() ! {
            client.close()
            throw E
        }
        co client.read_loop()
        return client
    }

    /// Executes a unary RPC with raw request bytes and returns `UnaryResponse`.
    + fn unary(method: String, request: local &[u8], options: ?CallOptions (null)) UnaryResponse !GrpcError {
        let stream = this.open_stream(method, options, false) !>
        let comp = isset(options) ? options.compression : this.opts.compression
        let max_send = (isset(options) && options.max_send_size > 0) ? options.max_send_size : this.opts.max_send_message_size
        let frame = encode_frame(request, comp, max_send) ! {
            stream.cancel()
            throw E
        }
        stream.send_closed = true
        this.send_stream_data(stream, frame, true) ! {
            stream.cancel()
            throw E
        }
        let body = (stream.recv() !>) ?? ""
        if !stream.remote_eof {
            let extra = stream.recv() !>
            if isset(extra) {
                stream.cancel()
                throw err(.internal, "Received multiple messages for unary RPC")
            }
        }
        return UnaryResponse {
            body: body
            headers: stream.resp_headers
            trailers: stream.resp_trailers
        }
    }

    /// Opens a server-streaming RPC, immediately sends `request`, and half-closes the send side.
    + fn server_stream(method: String, request: local &[u8], options: ?CallOptions (null)) ClientStream !GrpcError {
        let stream = this.open_stream(method, options, false) !>
        let comp = isset(options) ? options.compression : this.opts.compression
        let max_send = (isset(options) && options.max_send_size > 0) ? options.max_send_size : this.opts.max_send_message_size
        let frame = encode_frame(request, comp, max_send) ! {
            stream.cancel()
            throw E
        }
        stream.send_closed = true
        this.send_stream_data(stream, frame, true) ! {
            stream.cancel()
            throw E
        }
        return stream
    }

    /// Opens a client-streaming RPC. Send messages with `send()`, then call `finish()`.
    + fn client_stream(method: String, options: ?CallOptions (null)) ClientStream !GrpcError {
        return this.open_stream(method, options, false) !>
    }

    /// Opens a bidirectional streaming RPC.
    + fn bidi_stream(method: String, options: ?CallOptions (null)) ClientStream !GrpcError {
        return this.open_stream(method, options, false) !>
    }

    /// Generic unary RPC helper for any `valk-protobuf` message types `Req` and `Res`.
    + fn call_unary[Req, Res](method: String, req: Req, options: ?CallOptions (null)) Res !GrpcError {
        let resp = this.unary(method, req.to_proto_bytes(), options) !>
        return decode_proto[Res](resp.body) !>
    }

    /// Generic server-streaming RPC helper for `valk-protobuf` message types `Req` and `Res`.
    + fn call_server_stream[Req, Res](method: String, req: Req, options: ?CallOptions (null)) TypedClientStream[Req, Res] !GrpcError {
        let raw = this.server_stream(method, req.to_proto_bytes(), options) !>
        return TypedClientStream[Req, Res].new(raw)
    }

    /// Generic client-streaming RPC helper for `valk-protobuf` message types `Req` and `Res`.
    + fn call_client_stream[Req, Res](method: String, options: ?CallOptions (null)) TypedClientStream[Req, Res] !GrpcError {
        let raw = this.client_stream(method, options) !>
        return TypedClientStream[Req, Res].new(raw)
    }

    /// Generic bidirectional streaming RPC helper for `valk-protobuf` message types `Req` and `Res`.
    + fn call_bidi_stream[Req, Res](method: String, options: ?CallOptions (null)) TypedClientStream[Req, Res] !GrpcError {
        let raw = this.bidi_stream(method, options) !>
        return TypedClientStream[Req, Res].new(raw)
    }

    /// Closes the underlying HTTP/2 connection and fails any in-flight streams.
    + fn close() {
        if this.closed : return
        this.closed = true
        let list = Array[ClientStream].new()
        each this.streams as st : list.append(st)
        this.streams.clear()
        each list as st {
            st.fail(err(.unavailable, "gRPC client closed"))
        }
        this.wake_window_waiters()
        this.con.close() ! {}
    }

    fn open_stream(method: String, options: ?CallOptions, end_stream: bool) ClientStream !GrpcError {
        if this.closed || this.goaway : throw err(.unavailable, "gRPC connection is closed")
        if this.next_stream_id > 0x7ffffffd : throw err(.unavailable, "HTTP/2 stream IDs exhausted")

        let path = normalize_method_path(method)
        let comp = isset(options) ? options.compression : this.opts.compression
        let timeout_ms = (isset(options) && options.timeout_ms > 0) ? options.timeout_ms : this.opts.default_timeout_ms
        let max_recv = (isset(options) && options.max_recv_size > 0) ? options.max_recv_size : this.opts.max_recv_message_size
        let max_send = (isset(options) && options.max_send_size > 0) ? options.max_send_size : this.opts.max_send_message_size
        let deadline_ms: uint = timeout_ms > 0 ? time.mono_ms() + timeout_ms : 0

        let fields = Array[HeaderField] {
            .{ name: ":method", value: "POST" },
            .{ name: ":scheme", value: this.scheme },
            .{ name: ":path", value: path },
            .{ name: ":authority", value: this.authority },
            .{ name: "content-type", value: "application/grpc" },
            .{ name: "te", value: "trailers" },
            .{ name: "user-agent", value: this.opts.user_agent },
            .{ name: "grpc-accept-encoding", value: "identity,gzip" },
        }
        if comp != .identity {
            fields.append(.{ name: "grpc-encoding", value: compression_name(comp) })
        }
        if timeout_ms > 0 {
            fields.append(.{ name: "grpc-timeout", value: format_timeout_ms(timeout_ms) })
        }
        if isset(options) {
            let md = options.metadata
            if isset(md) {
                each md as val, key {
                    if is_valid_metadata_key(key) && !is_reserved_transport_header(key) {
                        fields.append(.{ name: key, value: val, never_index: true })
                    }
                }
            }
        }

        let stream_id = this.next_stream_id
        this.next_stream_id += 2
        let waker = sync.Waker.new() ! throw err(.internal, "Failed to create stream waker")
        let st = ClientStream {
            client: this
            stream_id: stream_id
            waker: waker
            decoder: FrameDecoder.new(.identity, max_recv)
            compression: comp
            max_send_size: max_send
            deadline_ms: deadline_ms
            send_window: this.peer_settings.initial_window_size.to(int)
        }
        this.streams.set(stream_id, st)

        let block = this.encoder.encode(fields)
        let out = ByteBuffer.new(block.bytes + 32)
        h2_encode_headers(out, stream_id, block, end_stream, this.peer_settings.max_frame_size)
        this.write_bytes(out.view()) ! {
            this.streams.remove(stream_id)
            throw E
        }
        return st
    }

    fn lock_write() {
        while this.write_busy {
            let w = sync.Waker.new() ! {
                time.sleep_ms(1)
                continue
            }
            this.write_waiters.append(w)
            w.wait()
        }
        this.write_busy = true
    }

    fn unlock_write() {
        this.write_busy = false
        if this.write_waiters.length > 0 {
            let w = this.write_waiters.pop_first() ! return
            w.wake()
        }
    }

    fn write_bytes(data: local &[u8]) !GrpcError {
        this.lock_write()
        defer this.unlock_write()
        if this.closed : throw err(.unavailable, "gRPC connection closed")
        this.con.write_timeout_ms = this.opts.write_timeout_ms
        let view = data
        while view.length > 0 {
            let n = this.con.write(view) ! {
                this.close()
                throw err(.unavailable, "Failed writing to gRPC connection")
            }
            if n == 0 || n > view.length {
                this.close()
                throw err(.unavailable, "Short write on gRPC connection")
            }
            view = view.view(n, view.length - n)
        }
    }

    fn wake_window_waiters() {
        while this.window_waiters.length > 0 {
            let w = this.window_waiters.pop_first() ! break
            w.wake()
        }
    }

    fn send_preface() !GrpcError {
        let out = ByteBuffer.new(96)
        out.write(H2_PREFACE)
        h2_encode_initial_settings(out, 0, H2_TARGET_WINDOW, H2_DEFAULT_MAX_FRAME_SIZE, true)
        this.write_bytes(out.view()) !>
    }

    fn send_stream_data(st: ClientStream, data: local &[u8], end_stream: bool) !GrpcError {
        if data.length == 0 {
            if end_stream {
                let out = ByteBuffer.new(9)
                h2_encode_frame(out, H2_DATA, H2_FLAG_END_STREAM, st.stream_id, "")
                this.write_bytes(out.view()) !>
            }
            return
        }
        let pos: uint = 0
        while pos < data.length {
            while !this.closed && !st.remote_eof && (this.send_window <= 0 || st.send_window <= 0) {
                st.check_deadline() !>
                let wait_ms: uint = this.opts.write_timeout_ms
                if st.deadline_ms > 0 {
                    let rem = st.deadline_ms > time.mono_ms() ? st.deadline_ms - time.mono_ms() : 0
                    if rem == 0 : st.check_deadline() !>
                    if wait_ms == 0 || rem < wait_ms : wait_ms = rem
                }
                let w = sync.Waker.new() ! throw err(.internal, "Failed to allocate flow-control waker")
                if this.send_window <= 0 {
                    this.window_waiters.append(w)
                } else {
                    st.send_window_waiters.append(w)
                }
                if !w.wait(wait_ms) {
                    st.check_deadline() !>
                    if this.send_window <= 0 || st.send_window <= 0 {
                        throw err(.deadline_exceeded, "Flow-control send timeout")
                    }
                }
            }
            if this.closed : throw err(.unavailable, "Connection closed while sending")
            if st.remote_eof {
                let terr = st.transport_error
                if isset(terr) : throw terr
                st.verify_final_status() !>
                throw err(.cancelled, "Server closed stream early")
            }

            let avail_conn = this.send_window.to(uint)
            let avail_stream = st.send_window.to(uint)
            let max_frame = this.peer_settings.max_frame_size.to(uint)
            if max_frame < H2_DEFAULT_MAX_FRAME_SIZE : max_frame = H2_DEFAULT_MAX_FRAME_SIZE
            let chunk = data.length - pos
            if chunk > max_frame : chunk = max_frame
            if chunk > avail_conn : chunk = avail_conn
            if chunk > avail_stream : chunk = avail_stream

            let is_last = pos + chunk == data.length
            let flags: u8 = (end_stream && is_last) ? H2_FLAG_END_STREAM : 0
            let out = ByteBuffer.new(chunk + 9)
            h2_encode_frame(out, H2_DATA, flags, st.stream_id, data.view(pos, chunk))
            this.send_window -= chunk.to(int)
            st.send_window -= chunk.to(int)
            this.write_bytes(out.view()) !>
            pos += chunk
        }
    }

    fn cancel_stream(stream_id: u32) {
        this.streams.remove(stream_id)
        if this.closed : return
        let out = ByteBuffer.new(13)
        h2_encode_rst_stream(out, stream_id, H2_ERR_CANCEL)
        this.write_bytes(out.view()) ! {}
    }

    fn read_loop() {
        while !this.closed {
            this.process_frames() ! {
                this.fail_all(E)
                break
            }
            if this.closed : break

            this.con.read_timeout_ms = 200
            this.recv_buf.reserve(16_393)
            let n = this.con.read(this.recv_buf.view_spare(16_393)) ! {
                if this.closed : break
                if E == .timeout : continue
                this.fail_all(err(.unavailable, "gRPC connection closed by peer"))
                break
            }
            if n == 0 {
                this.fail_all(err(.unavailable, "gRPC connection EOF"))
                break
            }
            this.recv_buf.skip(n)
        }
        this.close()
    }

    fn process_frames() !GrpcError {
        while !this.closed {
            let frame = (h2_try_read_frame(this.recv_buf, H2_DEFAULT_MAX_FRAME_SIZE) !>) ?! break
            this.handle_frame(frame) !>
        }
        if this.recv_buf.length == 0 && this.recv_buf.size > 65_536 {
            this.recv_buf.shrink_capacity(16_384)
        }
    }

    fn handle_frame(frame: H2Frame) !GrpcError {
        if this.assembler.stream != 0 {
            if frame.kind != H2_CONTINUATION || frame.stream != this.assembler.stream {
                throw err(.internal, "Expected HTTP/2 CONTINUATION frame")
            }
        } else if frame.kind == H2_CONTINUATION {
            throw err(.internal, "Unexpected HTTP/2 CONTINUATION frame")
        }

        if frame.kind == H2_SETTINGS {
            if (frame.flags & H2_FLAG_ACK) != 0 : return
            let old_win = this.peer_settings.initial_window_size.to(int)
            this.peer_settings.apply(frame.payload) !>
            let new_win = this.peer_settings.initial_window_size.to(int)
            let delta = new_win - old_win
            if delta != 0 {
                each this.streams as st {
                    st.send_window += delta
                    if delta > 0 : st.wake_window_waiters()
                }
            }
            let ack = ByteBuffer.new(9)
            h2_encode_settings_ack(ack)
            this.write_bytes(ack.view()) ! {}
            return
        }

        if frame.kind == H2_PING {
            if frame.payload.bytes != 8 : throw err(.internal, "Invalid PING payload")
            if (frame.flags & H2_FLAG_ACK) != 0 : return
            let pong = ByteBuffer.new(17)
            h2_encode_ping(pong, frame.payload, true)
            this.write_bytes(pong.view()) ! {}
            return
        }

        if frame.kind == H2_WINDOW_UPDATE {
            if frame.payload.bytes != 4 : throw err(.internal, "Invalid WINDOW_UPDATE")
            let inc = (h2_read_u32_be(frame.payload, 0) & 0x7fffffff).to(int)
            if inc <= 0 : throw err(.internal, "Zero WINDOW_UPDATE")
            if frame.stream == 0 {
                this.send_window += inc
                this.wake_window_waiters()
            } else {
                let st = this.streams.get(frame.stream) !? null
                if isset(st) {
                    st.send_window += inc
                    st.wake_window_waiters()
                }
            }
            return
        }

        if frame.kind == H2_GOAWAY {
            if frame.payload.bytes < 8 : throw err(.internal, "Invalid GOAWAY")
            let last_stream = h2_read_u32_be(frame.payload, 0) & 0x7fffffff
            this.goaway = true
            let keys = Array[u32].new()
            each this.streams as _, sid : keys.append(sid)
            each keys as sid {
                if sid > last_stream {
                    let st = this.streams.get(sid) !? null
                    if isset(st) {
                        this.streams.remove(sid)
                        st.fail(err(.unavailable, "Server shutting down (GOAWAY)"))
                    }
                }
            }
            return
        }

        if frame.kind == H2_RST_STREAM {
            let code = frame.payload.bytes >= 4 ? h2_read_u32_be(frame.payload, 0) : H2_ERR_INTERNAL
            let st = this.streams.get(frame.stream) !? null
            if isset(st) {
                this.streams.remove(frame.stream)
                let grpc_code = map_h2_rst_to_grpc(code)
                st.fail(err(grpc_code, "Stream reset by server (HTTP/2 error %{code})"))
            }
            return
        }

        if frame.kind == H2_HEADERS || frame.kind == H2_CONTINUATION {
            let stream_id = frame.stream
            let block = (this.assembler.accept(frame) !>) ?! return
            let end_stream = this.assembler.end_stream
            let fields = this.decoder.decode(block) !>
            let st = this.streams.get(stream_id) !? null
            if !isset(st) : return

            if !st.headers_received {
                each fields as f {
                    if f.name == ":status" {
                        let code = f.value.to_uint() !? 0
                        st.http_status = code.to(u16)
                    } else if f.name == "grpc-encoding" {
                        let comp = compression_from_name(f.value) ! {
                            this.streams.remove(stream_id)
                            st.fail(E)
                            return
                        }
                        st.decoder.compression = comp
                    } else if f.name == "grpc-status" {
                        let parsed = f.value.to_int() !? 2
                        st.grpc_status_set = true
                        st.grpc_status_code = parsed.to(i32)
                    } else if f.name == "grpc-message" {
                        st.grpc_message = f.value
                    } else if f.name == "grpc-status-details-bin" {
                        st.grpc_details_bin = f.value
                    } else if !is_reserved_transport_header(f.name) {
                        st.resp_headers.append(f.name, f.value)
                        if end_stream : st.resp_trailers.append(f.name, f.value)
                    }
                }
                st.headers_received = true
                if end_stream {
                    st.trailers_received = true
                    st.remote_eof = true
                    this.streams.remove(stream_id)
                }
                st.waker.wake()
            } else {
                // Trailing HEADERS frame
                each fields as f {
                    if f.name == "grpc-status" {
                        let parsed = f.value.to_int() !? 2
                        st.grpc_status_set = true
                        st.grpc_status_code = parsed.to(i32)
                    } else if f.name == "grpc-message" {
                        st.grpc_message = f.value
                    } else if f.name == "grpc-status-details-bin" {
                        st.grpc_details_bin = f.value
                    } else if !is_reserved_transport_header(f.name) {
                        st.resp_trailers.append(f.name, f.value)
                    }
                }
                st.trailers_received = true
                if end_stream {
                    st.remote_eof = true
                    this.streams.remove(stream_id)
                }
                st.waker.wake()
            }
            return
        }

        if frame.kind == H2_DATA {
            let flow_len = frame.payload.bytes
            this.conn_recv_window -= flow_len.to(int)
            this.conn_unacked_recv += flow_len
            let st = this.streams.get(frame.stream) !? null
            if !isset(st) {
                this.maybe_send_conn_window_update()
                return
            }
            st.recv_window -= flow_len.to(int)
            st.unacked_recv += flow_len

            let data = frame.fragment() !>
            if data.bytes > 0 : st.decoder.push(data)
            if (frame.flags & H2_FLAG_END_STREAM) != 0 {
                st.remote_eof = true
                this.streams.remove(frame.stream)
            } else {
                this.maybe_send_stream_window_update(st)
            }
            st.waker.wake()
            this.maybe_send_conn_window_update()
            return
        }
    }

    fn maybe_send_conn_window_update() {
        let inc = this.conn_unacked_recv
        if inc < H2_TARGET_WINDOW / 2 : return
        this.conn_unacked_recv = 0
        this.conn_recv_window += inc.to(int)
        let out = ByteBuffer.new(13)
        h2_encode_window_update(out, 0, inc.to(u32))
        this.write_bytes(out.view()) ! {}
    }

    fn maybe_send_stream_window_update(st: ClientStream) {
        let inc = st.unacked_recv
        if inc < H2_TARGET_WINDOW / 2 : return
        st.unacked_recv = 0
        st.recv_window += inc.to(int)
        let out = ByteBuffer.new(13)
        h2_encode_window_update(out, st.stream_id, inc.to(u32))
        this.write_bytes(out.view()) ! {}
    }

    fn fail_all(e: GrpcError) {
        let list = Array[ClientStream].new()
        each this.streams as st : list.append(st)
        this.streams.clear()
        each list as st : st.fail(e)
        this.wake_window_waiters()
    }
}

fn map_h2_rst_to_grpc(h2_err: u32) StatusCode {
    return match h2_err : StatusCode {
        0, 1, 2, 3, 6 => .internal
        7 => .unavailable
        8 => .cancelled
        9 => .internal
        11 => .resource_exhausted
        12 => .permission_denied
        default => .unknown
    }
}

fn parse_grpc_target(target: String, default_tls: bool) (String, u16, bool) !GrpcError {
    let s = target.trim()
    let use_tls = default_tls
    if s.starts_with("https://") {
        use_tls = true
        s = s.range(8, s.bytes - 8)
    } else if s.starts_with("http://") {
        s = s.range(7, s.bytes - 7)
    } else if s.starts_with("dns:///") {
        s = s.range(7, s.bytes - 7)
    }
    // Strip trailing path if any
    s.index_of_byte('/') -> slash {
        s = s.range(0, slash)
    }
    if s.bytes == 0 : throw err(.invalid_argument, "Empty gRPC target address")

    let host = ""
    let port: u16 = use_tls ? 443 : 80
    if s.starts_with("[") {
        let close = s.index_of_byte(']') ! throw err(.invalid_argument, "Invalid IPv6 target: %{target}")
        host = s.range(1, close - 1)
        if close + 1 < s.bytes {
            if s[close + 1] != ':' : throw err(.invalid_argument, "Invalid IPv6 target port: %{target}")
            let p = s.range(close + 2, s.bytes - close - 2).to_uint() ! throw err(.invalid_argument, "Invalid port in target: %{target}")
            if p == 0 || p > 65535 : throw err(.invalid_argument, "Port out of range in target: %{target}")
            port = p.to(u16)
        }
    } else {
        let colon = s.index_of_byte(':') !? s.bytes
        if colon < s.bytes {
            host = s.range(0, colon)
            let p = s.range(colon + 1, s.bytes - colon - 1).to_uint() ! throw err(.invalid_argument, "Invalid port in target: %{target}")
            if p == 0 || p > 65535 : throw err(.invalid_argument, "Port out of range in target: %{target}")
            port = p.to(u16)
        } else {
            host = s
        }
    }
    if host.bytes == 0 : throw err(.invalid_argument, "Missing host in target: %{target}")
    return (host, port, use_tls)
}
